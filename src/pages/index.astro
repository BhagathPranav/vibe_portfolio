---
import Layout from '../components/Layout.astro';
import { person, bio, education } from '../data/site';
import { projects } from '../data/projects';
import { certificates } from '../data/certificates';

const featuredProjectTitles = [
  'AI-chart',
  'Pinventory',
  'Vibe Portfolio',
  'Customer Shopping Behavior Analysis'
];

const featuredProjects = featuredProjectTitles
  .map(title => projects.find(p => p.title === title))
  .filter((p): p is typeof projects[0] => !!p);

const featuredCertTitles = [
  'Cloud Computing Internship Certificate',
  'AWS Certified Cloud Practitioner',
  'Data Analyst Career Track',
  'Full Stack Development with MERN'
];

const featuredCertificates = featuredCertTitles
  .map(title => certificates.find(c => c.title === title))
  .filter((c): c is typeof certificates[0] => !!c);

const projectIcons: Record<string, string> = {
  'AI-chart': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C12 7.5 16.5 12 22 12C16.5 12 12 16.5 12 22C12 16.5 7.5 12 2 12C7.5 12 12 7.5 12 2Z" /></svg>`,
  'Pinventory': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><rect x="5" y="3" width="4" height="18" rx="1" /><path d="M11 3h5a5 5 0 0 1 0 10h-5V3z" /></svg>`,
  'Vibe Portfolio': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zm0 18c4.41 0 8-3.59 8-8s-3.59-8-8-8-8 3.59-8 8 3.59 8 8 8zm0-14a6 6 0 0 0-6 6h2a4 4 0 0 1 4-4V6zm0 12a6 6 0 0 0 6-6h-2a4 4 0 0 1-4 4v2z" /></svg>`,
  'Customer Shopping Behavior Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 9 9h5v-3h-5a6 6 0 0 1-6-6 6 6 0 0 1 6-6h5V3h-5z" /></svg>`
};

const certIcons: Record<string, string> = {
  'Cloud Computing Internship Certificate': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z"/></svg>`,
  'AWS Certified Cloud Practitioner': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM12 17l-4-4h2.5V9h3v4H16l-4 4z"/></svg>`,
  'Data Analyst Career Track': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>`,
  'Full Stack Development with MERN': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>`
};

const skills = [
  {
    name: 'Python',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-current"><path d="M14.25.18c-.9 0-1.66.72-1.66 1.62v2.7h5.13c1.37 0 2.5 1.11 2.5 2.48v2.02h1.6c.9 0 1.62-.73 1.62-1.63V4.62c0-2.43-1.97-4.44-4.43-4.44h-4.76zM9.75 6.7c-1.37 0-2.5 1.11-2.5 2.48v2.02H2.12c-.9 0-1.62.73-1.62 1.63v2.75c0 2.43 1.97 4.44 4.43 4.44h4.76c.9 0 1.66-.72 1.66-1.62v-2.7H6.22c-1.37 0-2.5-1.11-2.5-2.48v-2.02h6.16c.9 0 1.62-.73 1.62-1.63V9.18c0-2.43-1.97-4.44-4.43-4.44H9.75z"/></svg>`
  },
  {
    name: 'SQL',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path></svg>`
  },
  {
    name: 'Data Analysis',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`
  },
  {
    name: 'Astro',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.5-2.5 3.5-2.5 5.5 2 0 4-1 5.5-2.5L18.5 8.5c1.5-1.5 2.5-3.5 2.5-5.5-2 0-4 1-5.5 2.5L4.5 16.5z"></path><path d="M12 12l4 4M8 8l4 4"></path></svg>`
  },
  {
    name: 'TypeScript',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-current"><path d="M2 2h20v20H2V2zm12.58 12.3c0-.77-.32-1.34-.95-1.74-.53-.33-1.29-.62-2.29-.86-.9-.22-1.53-.45-1.9-.68a1.27 1.27 0 0 1-.55-1.12c0-.39.18-.73.54-.99.37-.26.91-.39 1.62-.39.73 0 1.29.17 1.69.52.4.34.62.83.65 1.47h2.24c-.04-1.14-.46-2.02-1.25-2.63C13.75 7.27 12.65 7 11.27 7c-1.27 0-2.31.33-3.1 1-.79.67-1.18 1.57-1.18 2.7 0 .8.3 1.44.89 1.93.59.48 1.49.85 2.68 1.1.95.2 1.62.43 2 .68.38.25.57.59.57 1.03 0 .42-.19.79-.57 1.09-.39.3-.96.45-1.73.45-.89 0-1.56-.23-2.02-.69-.47-.46-.71-1.11-.73-1.95H6c.02 1.36.47 2.42 1.35 3.16.89.75 2.08 1.12 3.59 1.12 1.34 0 2.42-.32 3.23-.97.8-.65 1.21-1.55 1.21-2.7zM22 7.02h-4.33v9.75c0 .35.08.6.24.73.16.14.44.2.85.2h3.24V20h-.5c-.88 0-1.56-.09-2.03-.27-.47-.19-.85-.47-1.13-.85-.29-.39-.46-.86-.5-1.43v-7.41h-2.06V7.02h5.66v2.33H22V7.02z"/></svg>`
  },
  {
    name: 'Jupyter Notebook',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`
  },
  {
    name: 'Pandas',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"></path><path d="M21 9H3M21 15H3M12 3v18"></path></svg>`
  },
  {
    name: 'Tableau',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M12 7l5 5-5 5-5-5z"></path></svg>`
  },
  {
    name: 'MongoDB',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c0 0-4 4-4 8 0 3.3 1.7 6.2 4 7.5 2.3-1.3 4-4.2 4-7.5 0-4-4-8-4-8z"></path><path d="M12 2v20"></path></svg>`
  },
  {
    name: 'React',
    icon: `<svg viewBox="0 0 24 24" class="w-12 h-12 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(30 12 12)"></ellipse><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(90 12 12)"></ellipse><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(150 12 12)"></ellipse><circle cx="12" cy="12" r="1"></circle></svg>`
  }
];
---

<Layout title={person.fullName} description={person.metaDescription}>
  <!-- 1. Hero Section -->
  <section class="px-6 pt-16 pb-20 md:px-12 md:pt-24 md:pb-28 min-h-[60vh] flex flex-col justify-start">
    <div class="container-content">
      <h1 class="headline mb-12 max-w-[14ch] text-6xl leading-[0.9] md:text-8xl lg:text-[10rem] fade-up text-foreground">
        DATA ANALYST & <br/> IT DEVELOPER
      </h1>
      <div class="fade-up stagger-1">
        <p class="max-w-[600px] font-body text-xl text-muted md:text-2xl leading-relaxed">
          {person.tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Stats Bar -->
  <section class="border-y border-borderline/20 bg-transparent">
    <div class="container-content px-6 py-16 md:px-12 grid grid-cols-3 gap-6 text-center md:text-left fade-up animate-counter-container">
      <div class="flex flex-col md:items-start items-center gap-1">
        <p class="headline text-4xl md:text-7xl text-accent">
          +<span class="animate-counter" data-target="2">0</span>
        </p>
        <p class="font-display font-bold uppercase tracking-widest text-[10px] md:text-xs text-muted">Years Experience</p>
      </div>
      <div class="flex flex-col md:items-start items-center gap-1">
        <p class="headline text-4xl md:text-7xl text-accent">
          +<span class="animate-counter" data-target="9">0</span>
        </p>
        <p class="font-display font-bold uppercase tracking-widest text-[10px] md:text-xs text-muted">Projects Completed</p>
      </div>
      <div class="flex flex-col md:items-start items-center gap-1">
        <p class="headline text-4xl md:text-7xl text-accent">
          +<span class="animate-counter" data-target="4">0</span>
        </p>
        <p class="font-display font-bold uppercase tracking-widest text-[10px] md:text-xs text-muted">Tech Stacks Mastered</p>
      </div>
    </div>
  </section>

  <!-- 3. Skills Tags -->
  <section class="border-t border-borderline/20 section-padding">
    <div class="container-content">
      <div class="mb-16 flex items-center justify-between gap-6 fade-up">
        <h2 class="headline text-5xl md:text-7xl text-accent uppercase shrink-0">Skills</h2>
        <div class="h-[1px] bg-borderline/20 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-[6px] bg-accent"></div>
        </div>
      </div>
      
      <div class="max-w-3xl mb-12 fade-up">
        <p class="font-body text-lg md:text-xl text-muted leading-relaxed">
          I specialize in SQL-driven analytics, Python notebooks, and interactive dashboards—combined with modern static sites to bring data insights and web applications to life. Here is my core technology stack and tools.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
        {
          skills.map((skill, index) => (
            <div
              class="group flex flex-col items-center justify-center p-8 bg-[#0d0d0d] border border-borderline/20 hover:border-accent/40 rounded-2xl transition-all duration-300 aspect-square text-center fade-up"
              style={`transition-delay: ${index * 50}ms`}
            >
              <div class="mb-4 text-[#888] group-hover:text-accent transition-colors duration-500 ease-out transform group-hover:scale-105">
                <Fragment set:html={skill.icon} />
              </div>
              <span class="font-display text-xs font-bold tracking-widest uppercase text-muted group-hover:text-foreground transition-colors duration-300">
                {skill.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Recent Projects -->
  <section class="border-t border-borderline/20 section-padding">
    <div class="container-content">
      <div class="mb-16 flex items-center justify-between gap-6 fade-up">
        <h2 class="headline text-5xl md:text-7xl text-accent uppercase shrink-0">Projects</h2>
        <div class="h-[1px] bg-borderline/20 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-[6px] bg-accent"></div>
        </div>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {
          featuredProjects.map((project, index) => (
            <div
              class="project-card group relative block w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0d0d0d] aspect-[16/11] fade-up"
              style={`transition-delay: ${index * 100}ms`}
            >
              {/* Entire background link to project repo */}
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 z-0 outline-none"
                aria-label={`View ${project.title} on GitHub`}
              >
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="absolute inset-0 w-full h-full object-cover grayscale brightness-[0.2] contrast-[1.2] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-[0.25] group-hover:grayscale-[50%]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-[#0d0d0d] transition-all duration-700 ease-out group-hover:scale-105" />
                )}

                {/* Centered Icon (Default State) */}
                <div class="project-icon absolute inset-0 flex items-center justify-center transition-all duration-500 ease-out group-hover:scale-90 group-hover:opacity-0">
                  <Fragment set:html={projectIcons[project.title]} />
                </div>
              </a>

              {/* Hover Overlay (Fades In) */}
              <div class="absolute inset-0 bg-black/85 backdrop-blur-[6px] opacity-0 pointer-events-none group-hover:pointer-events-auto transition-opacity duration-500 ease-out group-hover:opacity-100 flex flex-col justify-end p-8 z-10">
                <div class="transform translate-y-4 transition-transform duration-500 ease-out group-hover:translate-y-0 flex flex-col gap-3">
                  <span class="font-display text-xs font-bold uppercase tracking-widest text-accent">
                    {project.mainTech || project.tags[0]}
                  </span>
                  <h3 class="headline text-2xl md:text-3xl text-foreground leading-tight">
                    {project.title}
                  </h3>
                  <p class="font-body text-sm text-muted leading-relaxed max-w-[90%]">
                    {project.description}
                  </p>
                  <div class="mt-2 flex items-center gap-6">
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-20"
                    >
                      View Project <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </a>
                    {project.live && (
                      <a
                        href={project.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-20"
                      >
                        Live Demo <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-16 flex justify-center fade-up">
        <a href="/projects" class="font-display text-sm font-bold uppercase tracking-widest text-accent hover:text-foreground transition-colors duration-300">
          All projects ↗
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Recent Certificates -->
  <section class="border-t border-borderline/20 section-padding">
    <div class="container-content">
      <div class="mb-16 flex items-center justify-between gap-6 fade-up">
        <h2 class="headline text-5xl md:text-7xl text-accent uppercase shrink-0">Certificates</h2>
        <div class="h-[1px] bg-borderline/20 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-[6px] bg-accent"></div>
        </div>
      </div>
      
      <div class="grid gap-8 md:grid-cols-2">
        {
          featuredCertificates.map((cert, index) => (
            <div
              class="project-card group relative block w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0d0d0d] aspect-[16/11] fade-up"
              style={`transition-delay: ${index * 100}ms`}
            >
              {/* Link container for base hover */}
              <a
                href={cert.file}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 z-0 outline-none"
                aria-label={`View ${cert.title}`}
              >
                <div class="absolute inset-0 w-full h-full bg-[#0d0d0d] transition-all duration-700 ease-out group-hover:scale-105" />

                {/* Centered Icon (Default State) */}
                <div class="project-icon absolute inset-0 flex items-center justify-center transition-all duration-500 ease-out group-hover:scale-90 group-hover:opacity-0">
                  <Fragment set:html={certIcons[cert.title] || certIcons['AWS Certified Cloud Practitioner']} />
                </div>
              </a>

              {/* Hover Overlay (Fades In) */}
              <div class="absolute inset-0 bg-black/85 backdrop-blur-[6px] opacity-0 pointer-events-none group-hover:pointer-events-auto transition-opacity duration-500 ease-out group-hover:opacity-100 flex flex-col justify-end p-8 z-10">
                <div class="transform translate-y-4 transition-transform duration-500 ease-out group-hover:translate-y-0 flex flex-col gap-3">
                  <span class="font-display text-xs font-bold uppercase tracking-widest text-accent">
                    {cert.category}
                  </span>
                  <h3 class="headline text-2xl md:text-3xl text-foreground leading-tight">
                    {cert.title}
                  </h3>
                  <div class="flex flex-col gap-1">
                    <p class="font-body text-sm text-muted leading-relaxed">
                      Issuer: <span class="text-foreground">{cert.issuer}</span>
                    </p>
                    <p class="font-body text-sm text-muted">
                      Date: <span class="text-foreground">{cert.date}</span>
                    </p>
                  </div>
                  <div class="mt-2 flex items-center">
                    <a
                      href={cert.file}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-20"
                    >
                      View Certificate <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      
      <div class="mt-16 flex justify-center fade-up">
        <a href="/certificates" class="font-display text-sm font-bold uppercase tracking-widest text-accent hover:text-foreground transition-colors duration-300">
          All certificates ↗
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Experience Timeline -->
  <section class="border-t border-borderline/20 pt-32 pb-8 md:pt-40 md:pb-8 px-6 md:px-12">
    <div class="container-content max-w-4xl fade-up">
      <h2 class="headline mb-20 text-5xl md:text-7xl text-foreground">Experience</h2>
      <div class="flex flex-col border-t border-borderline/20">
        {
          education.map((entry) => (
            <div class="flex flex-col md:flex-row md:justify-between gap-6 md:gap-16 border-b border-borderline/20 py-12">
              <div class="md:w-1/3 shrink-0">
                <span class="font-display text-xl font-bold text-accent tracking-display">{entry.period}</span>
                <p class="font-display text-lg uppercase font-bold text-foreground mt-1">{entry.institution}</p>
              </div>
              <div class="md:w-2/3 flex flex-col gap-4 border-t border-borderline/20 pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-16">
                <h3 class="headline text-3xl md:text-4xl text-foreground leading-none">{entry.degree}</h3>
                {entry.highlights && (
                  <ul class="font-body text-base text-muted space-y-3 mt-2 list-none pl-0">
                    {entry.highlights.map(h => (
                      <li class="relative pl-6 before:content-['—'] before:absolute before:left-0 before:text-accent">{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))
        }
      </div>
  </section>

  <style>
    .project-card:hover .project-icon {
      opacity: 0 !important;
      transform: scale(0.9) !important;
    }
  </style>
</Layout>
