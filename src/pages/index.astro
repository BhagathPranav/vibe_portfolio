  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Interactive On-Page Resume Tab Switcher
      const resumeTabs = document.querySelectorAll('.resume-tab-btn');
      const resumePanels = document.querySelectorAll('.resume-tab-panel');

      const activeClasses = ['border-accent', 'text-background', 'bg-accent'];
      const inactiveClasses = ['border-white/10', 'text-muted', 'bg-[#161616]/40', 'hover:border-accent/50', 'hover:text-accent'];

      resumeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetTab = tab.getAttribute('data-tab');

          resumeTabs.forEach(t => {
            t.classList.remove(...activeClasses);
            t.classList.add(...inactiveClasses);
          });

          tab.classList.remove(...inactiveClasses);
          tab.classList.add(...activeClasses);

          resumePanels.forEach(panel => {
            if (panel.id === `resume-panel-${targetTab}`) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });

      // Skill Matrix Sub-Filter
      const skillFilterBtns = document.querySelectorAll('.skill-filter-btn');
      const skillCards = document.querySelectorAll('.skill-card');

      skillFilterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-skill-filter');

          skillFilterBtns.forEach(b => {
            b.classList.remove('border-accent', 'text-background', 'bg-accent');
            b.classList.add('border-white/10', 'text-muted', 'bg-[#161616]/40');
          });

          btn.classList.remove('border-white/10', 'text-muted', 'bg-[#161616]/40');
          btn.classList.add('border-accent', 'text-background', 'bg-accent');

          skillCards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });

      // Interactive Cursor Background Effect for Name Hero Section
      const nameHero = document.getElementById('name-hero');
      const cursorGlow = document.getElementById('cursor-glow');

      if (nameHero && cursorGlow) {
        nameHero.addEventListener('mousemove', (e) => {
          const rect = nameHero.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          cursorGlow.style.setProperty('--mouse-x', `${x}px`);
          cursorGlow.style.setProperty('--mouse-y', `${y}px`);
          cursorGlow.classList.remove('opacity-0');
          cursorGlow.classList.add('opacity-100');
        });

        nameHero.addEventListener('mouseleave', () => {
          cursorGlow.classList.remove('opacity-100');
          cursorGlow.classList.add('opacity-0');
        });
      }

      // Resume Modal Open/Close Controls
      const modal = document.getElementById('resume-modal');
      const openBtn = document.getElementById('open-resume-modal');
      const closeBtn = document.getElementById('close-resume-modal');

      if (openBtn && modal) {
        openBtn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        });
      }

      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        });
      }

      // Close modal on background click
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
          }
        });
      }

      // Close modal on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });
    });
  </script>

