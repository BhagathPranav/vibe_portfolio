---
import Layout from '../components/Layout.astro';
import { person } from '../data/site';
import { projects } from '../data/projects';

const projectIcons: Record<string, string> = {
  'AI-chart': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C12 7.5 16.5 12 22 12C16.5 12 12 16.5 12 22C12 16.5 7.5 12 2 12C7.5 12 12 7.5 12 2Z" /></svg>`,
  'Customer Shopping Behavior Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 9 9h5v-3h-5a6 6 0 0 1-6-6 6 6 0 0 1 6-6h5V3h-5z" /></svg>`,
  'Movie Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M8 5v14l11-7z" /></svg>`,
  'Pinventory': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><rect x="5" y="3" width="4" height="18" rx="1" /><path d="M11 3h5a5 5 0 0 1 0 10h-5V3z" /></svg>`,
  'Zepto E-Commerce Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M6 3h12v3H9.5L18 17v4H6v-3h8.5L6 6V3z" /></svg>`,
  'Zomato Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>`,
  'Travel Bucket': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.53c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.4z" /></svg>`,
  'SQL Learning Repo': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C6.48 2 2 4.02 2 6.5s4.48 4.5 10 4.5 10-2.02 10-4.5S17.52 2 12 2zm0 18c5.52 0 10-2.02 10-4.5v-3.5c0 2.48-4.48 4.5-10 4.5S2 12.48 2 10v3.5c0 2.48 4.48 4.5 10 4.5zm0-6c5.52 0 10-2.02 10-4.5V8c0 2.48-4.48 4.5-10 4.5S2 10.48 2 8v3.5c0 2.48 4.48 4.5 10 4.5z" /></svg>`,
  'Vibe Portfolio': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zm0 18c4.41 0 8-3.59 8-8s-3.59-8-8-8-8 3.59-8 8 3.59 8 8 8zm0-14a6 6 0 0 0-6 6h2a4 4 0 0 1 4-4V6zm0 12a6 6 0 0 0 6-6h-2a4 4 0 0 1-4 4v2z" /></svg>`
};

const isDataAnalysis = (project: typeof projects[0]) => {
  return (
    project.title.toLowerCase().includes('analysis') ||
    project.tags.some(tag => 
      ['data analytics', 'pandas', 'tableau'].includes(tag.toLowerCase())
    )
  );
};
---

<Layout
  title={`Projects — ${person.fullName}`}
  description={`GitHub projects by ${person.fullName}: SQL analytics, Python notebooks, Astro, JavaScript.`}
>
  <section class="section-padding">
    <div class="container-content">
      <div class="mb-16 flex items-center justify-between gap-6 fade-up">
        <h1 class="headline text-5xl md:text-7xl text-accent uppercase shrink-0">Projects</h1>
        <div class="h-[1px] bg-borderline/20 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-[6px] bg-accent"></div>
        </div>
      </div>
      <p class="max-w-2xl font-body text-xl text-muted leading-relaxed mb-16 fade-up">
        Each card opens the live GitHub repository—clone history, READMEs, and notebooks are the source of truth for depth.
      </p>

      {/* Filter Buttons */}
      <div class="flex flex-wrap gap-4 mb-12 fade-up">
        <button
          id="filter-all"
          class="px-6 py-2.5 font-display text-sm font-bold uppercase tracking-widest border border-accent text-background bg-accent scale-[1.05] hover:scale-[1.05] rounded-full outline-none transition-all duration-300 active:scale-[0.98]"
        >
          All Projects
        </button>
        <button
          id="filter-data"
          class="px-6 py-2.5 font-display text-sm font-bold uppercase tracking-widest border border-white/10 text-muted bg-[#161616]/40 hover:border-accent/50 hover:text-accent hover:bg-accent/5 hover:scale-[1.02] rounded-full outline-none transition-all duration-300 active:scale-[0.98]"
        >
          Data Analysis
        </button>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <div
              class="project-card group relative block w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0d0d0d] aspect-[16/11] fade-up"
              style={`transition-delay: ${index * 50}ms`}
              data-category={isDataAnalysis(project) ? "data-analysis" : "other"}
            >
              {/* Entire background link to project repo */}
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 z-0 outline-none"
                aria-label={`View ${project.title} on GitHub`}
              >
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="absolute inset-0 w-full h-full object-cover grayscale brightness-[0.2] contrast-[1.2] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-[0.25] group-hover:grayscale-[50%]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-[#0d0d0d] transition-all duration-700 ease-out group-hover:scale-105" />
                )}

                {/* Centered Icon (Default State) */}
                <div class="project-icon absolute inset-0 flex items-center justify-center transition-all duration-500 ease-out group-hover:scale-90 group-hover:opacity-0">
                  <Fragment set:html={projectIcons[project.title] || projectIcons['AI-chart']} />
                </div>
              </a>

              {/* Hover Overlay (Fades In) */}
              <div class="absolute inset-0 bg-black/85 backdrop-blur-[6px] opacity-0 pointer-events-none group-hover:pointer-events-auto transition-opacity duration-500 ease-out group-hover:opacity-100 flex flex-col justify-end p-8 z-10">
                <div class="transform translate-y-4 transition-transform duration-500 ease-out group-hover:translate-y-0 flex flex-col gap-3">
                  <span class="font-display text-xs font-bold uppercase tracking-widest text-accent">
                    {project.mainTech || project.tags[0]}
                  </span>
                  <h3 class="headline text-2xl md:text-3xl text-foreground leading-tight">
                    {project.title}
                  </h3>
                  <p class="font-body text-sm text-muted leading-relaxed max-w-[90%]">
                    {project.description}
                  </p>
                  <div class="mt-2 flex items-center gap-6">
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-20"
                    >
                      View Project <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </a>
                    {project.live && (
                      <a
                        href={project.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-20"
                      >
                        Live Demo <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .project-card:hover .project-icon {
      opacity: 0 !important;
      transform: scale(0.9) !important;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterAllBtn = document.getElementById('filter-all');
      const filterDataBtn = document.getElementById('filter-data');
      const cards = document.querySelectorAll('.project-card');
      
      const activeClasses = ['border-accent', 'text-background', 'bg-accent', 'scale-[1.05]', 'hover:scale-[1.05]'];
      const inactiveClasses = ['border-white/10', 'text-muted', 'bg-[#161616]/40', 'hover:border-accent/50', 'hover:text-accent', 'hover:bg-accent/5', 'hover:scale-[1.02]'];

      if (filterAllBtn && filterDataBtn) {
        filterAllBtn.addEventListener('click', () => {
          filterAllBtn.classList.remove(...inactiveClasses);
          filterAllBtn.classList.add(...activeClasses);
          filterDataBtn.classList.remove(...activeClasses);
          filterDataBtn.classList.add(...inactiveClasses);

          cards.forEach(card => {
            card.classList.remove('hidden');
            card.classList.remove('is-visible');
            setTimeout(() => {
              card.classList.add('is-visible');
            }, 50);
          });
        });

        filterDataBtn.addEventListener('click', () => {
          filterDataBtn.classList.remove(...inactiveClasses);
          filterDataBtn.classList.add(...activeClasses);
          filterAllBtn.classList.remove(...activeClasses);
          filterAllBtn.classList.add(...inactiveClasses);

          cards.forEach(card => {
            if (card.getAttribute('data-category') === 'data-analysis') {
              card.classList.remove('hidden');
              card.classList.remove('is-visible');
              setTimeout(() => {
                card.classList.add('is-visible');
              }, 50);
            } else {
              card.classList.add('hidden');
            }
          });
        });
      }
    });
  </script>
</Layout>
