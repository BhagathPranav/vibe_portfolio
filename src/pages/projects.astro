---
import Layout from '../components/Layout.astro';
import { person } from '../data/site';
import { projects } from '../data/projects';

const projectIcons: Record<string, string> = {
  'Cross-Platform Coding Aggregator': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4zM12 4.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 12a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></svg>`,
  'Friday Stark Voice Agent': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z"/></svg>`,
  'AI-chart': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-9 12H7v-2h4v2zm4-4H7V8h8v2z"/></svg>`,
  'Customer Shopping Behavior Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-9.83-3.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.13 0-.25-.11-.25-.25z"/></svg>`,
  'Movie Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4zm-6 10l-4-4h8l-4 4z"/></svg>`,
  'Pinventory': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
  'Zepto E-Commerce Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>`,
  'Zomato Data Analysis': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.55 3.89 3.57 4.23V22h2.86v-8.77C11.45 12.89 13 11.12 13 9V2h-2v7zm8-7h-2c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h2v7h2V4c0-1.1-.9-2-2-2z"/></svg>`,
  'Travel Bucket': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.53c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.4z"/></svg>`,
  'SQL Learning Repo': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2C6.48 2 2 4.02 2 6.5s4.48 4.5 10 4.5 10-2.02 10-4.5S17.52 2 12 2zm0 18c5.52 0 10-2.02 10-4.5v-3.5c0 2.48-4.48 4.5-10 4.5S2 12.48 2 10v3.5c0 2.48 4.48 4.5 10 4.5zm0-6c5.52 0 10-2.02 10-4.5V8c0 2.48-4.48 4.5-10 4.5S2 10.48 2 8v3.5c0 2.48 4.48 4.5 10 4.5z"/></svg>`,
  'Vibe Portfolio': `<svg viewBox="0 0 24 24" class="w-16 h-16 text-foreground fill-current opacity-90 transition-transform duration-500 group-hover:scale-110"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`
};

const isDataAnalysis = (project: typeof projects[0]) => {
  return (
    project.title.toLowerCase().includes('analysis') ||
    project.tags.some(tag => 
      ['data analytics', 'pandas', 'tableau'].includes(tag.toLowerCase())
    )
  );
};
---

<Layout
  title={`Projects — ${person.fullName}`}
  description={`GitHub projects by ${person.fullName}: SQL analytics, Python notebooks, Astro, JavaScript.`}
>
  <section class="section-padding">
    <div class="container-content">
      <div class="mb-16 flex items-center justify-between gap-6 fade-up">
        <h1 class="headline text-5xl md:text-7xl text-accent uppercase shrink-0">Projects</h1>
        <div class="h-[1px] bg-borderline/20 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-[6px] bg-accent"></div>
        </div>
      </div>
      <p class="max-w-2xl font-body text-xl text-muted leading-relaxed mb-16 fade-up">
        Each card opens the live GitHub repository—clone history, READMEs, and notebooks are the source of truth for depth.
      </p>

      {/* Filter Buttons */}
      <div class="flex flex-wrap gap-4 mb-12 fade-up">
        <button
          id="filter-all"
          class="px-6 py-2.5 font-display text-sm font-bold uppercase tracking-widest border border-accent text-background bg-accent scale-[1.05] hover:scale-[1.05] rounded-full outline-none transition-all duration-300 active:scale-[0.98]"
        >
          All Projects
        </button>
        <button
          id="filter-data"
          class="px-6 py-2.5 font-display text-sm font-bold uppercase tracking-widest border border-white/10 text-muted bg-[#161616]/40 hover:border-accent/50 hover:text-accent hover:bg-accent/5 hover:scale-[1.02] rounded-full outline-none transition-all duration-300 active:scale-[0.98]"
        >
          Data Analysis
        </button>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <div
              class="project-card group relative block w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0d0d0d] aspect-[16/11] fade-up"
              style={`transition-delay: ${index * 50}ms`}
              data-category={isDataAnalysis(project) ? "data-analysis" : "other"}
            >
              {/* Entire background link to project repo */}
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 z-0 outline-none"
                aria-label={`View ${project.title} on GitHub`}
              >
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="absolute inset-0 w-full h-full object-cover grayscale brightness-[0.2] contrast-[1.2] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-[0.25] group-hover:grayscale-[50%]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-[#0d0d0d] transition-all duration-700 ease-out group-hover:scale-105" />
                )}

                <!-- Top Impact Metric Pill (Visible Default) -->
                {project.impactMetric && (
                  <div class="absolute top-4 left-4 z-10 bg-black/80 backdrop-blur-md border border-accent/40 text-accent font-display text-[10px] sm:text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-lg">
                    {project.impactMetric}
                  </div>
                )}

                <!-- Bottom Default Title Bar -->
                <div class="absolute bottom-0 inset-x-0 p-5 bg-gradient-to-t from-black via-black/80 to-transparent z-10 transition-opacity duration-300 group-hover:opacity-0">
                  <span class="font-display text-[10px] font-bold uppercase tracking-widest text-accent block mb-0.5">
                    {project.mainTech || project.tags[0]}
                  </span>
                  <h3 class="headline text-lg sm:text-xl text-foreground truncate">
                    {project.title}
                  </h3>
                </div>

                {/* Centered Icon (Default State) */}
                <div class="project-icon absolute inset-0 flex items-center justify-center transition-all duration-500 ease-out group-hover:scale-90 group-hover:opacity-0">
                  <Fragment set:html={projectIcons[project.title] || projectIcons['AI-chart']} />
                </div>
              </a>

              {/* Hover Overlay (Fades In) */}
              <div class="absolute inset-0 bg-black/90 backdrop-blur-[6px] opacity-0 pointer-events-none group-hover:pointer-events-auto transition-opacity duration-500 ease-out group-hover:opacity-100 flex flex-col justify-end p-6 sm:p-8 z-20">
                <div class="transform translate-y-4 transition-transform duration-500 ease-out group-hover:translate-y-0 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-display text-xs font-bold uppercase tracking-widest text-accent">
                      {project.mainTech || project.tags[0]}
                    </span>
                  </div>
                  <h3 class="headline text-2xl md:text-3xl text-foreground leading-tight">
                    {project.title}
                  </h3>
                  {project.impactMetric && (
                    <p class="font-display text-xs font-bold text-accent tracking-wider uppercase border-l-2 border-accent pl-2.5 py-0.5 bg-accent/5">
                      {project.impactMetric}
                    </p>
                  )}
                  <p class="font-body text-xs sm:text-sm text-muted leading-relaxed">
                    {project.description}
                  </p>
                  <div class="mt-2 flex items-center gap-6">
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-30"
                    >
                      View Project <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </a>
                    {project.live && (
                      <a
                        href={project.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-display text-sm font-bold uppercase tracking-widest text-accent flex items-center gap-2 hover:text-foreground transition-colors duration-300 z-30"
                      >
                        Live Demo <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .project-card:hover .project-icon {
      opacity: 0 !important;
      transform: scale(0.9) !important;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterAllBtn = document.getElementById('filter-all');
      const filterDataBtn = document.getElementById('filter-data');
      const cards = document.querySelectorAll('.project-card');
      
      const activeClasses = ['border-accent', 'text-background', 'bg-accent', 'scale-[1.05]', 'hover:scale-[1.05]'];
      const inactiveClasses = ['border-white/10', 'text-muted', 'bg-[#161616]/40', 'hover:border-accent/50', 'hover:text-accent', 'hover:bg-accent/5', 'hover:scale-[1.02]'];

      if (filterAllBtn && filterDataBtn) {
        filterAllBtn.addEventListener('click', () => {
          filterAllBtn.classList.remove(...inactiveClasses);
          filterAllBtn.classList.add(...activeClasses);
          filterDataBtn.classList.remove(...activeClasses);
          filterDataBtn.classList.add(...inactiveClasses);

          cards.forEach(card => {
            card.classList.remove('hidden');
            card.classList.remove('is-visible');
            setTimeout(() => {
              card.classList.add('is-visible');
            }, 50);
          });
        });

        filterDataBtn.addEventListener('click', () => {
          filterDataBtn.classList.remove(...inactiveClasses);
          filterDataBtn.classList.add(...activeClasses);
          filterAllBtn.classList.remove(...activeClasses);
          filterAllBtn.classList.add(...inactiveClasses);

          cards.forEach(card => {
            if (card.getAttribute('data-category') === 'data-analysis') {
              card.classList.remove('hidden');
              card.classList.remove('is-visible');
              setTimeout(() => {
                card.classList.add('is-visible');
              }, 50);
            } else {
              card.classList.add('hidden');
            }
          });
        });
      }
    });
  </script>
</Layout>
