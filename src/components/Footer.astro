---
import { person, contact } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/certificates', label: 'Certificates' },
  { href: '/about', label: 'About' },
];
---

<footer class="bg-background text-foreground mt-0">
  <div class="container-content px-6 pt-10 pb-20 md:px-12 md:pt-10 md:pb-32">
    <div class="flex flex-col gap-16 md:flex-row md:items-start md:justify-between">
      <div class="flex flex-col gap-6 max-w-sm">
        <a href="/" class="headline text-4xl text-foreground transition-colors duration-300 hover:text-accent">
          {person.fullName}
        </a>
        <p class="font-body text-base text-muted leading-relaxed">
          Creating intuitive user experiences and turning complex data into clear insights.
        </p>
        <div class="flex flex-col gap-2.5 pt-2 font-body text-sm">
          <a href={`mailto:${contact.email}`} class="text-muted hover:text-accent transition-colors duration-300 flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-accent shrink-0" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            {contact.email}
          </a>
          <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent transition-colors duration-300 flex items-center gap-2">
            <svg class="w-4 h-4 fill-current text-accent shrink-0" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn Profile ↗
          </a>
        </div>
      </div>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-col gap-6 md:text-right">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="headline text-lg text-foreground transition-colors duration-300 hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={person.githubUrl}
              class="headline text-lg text-foreground transition-colors duration-300 hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>
          </li>
        </ul>
      </nav>
    </div>
    
    <div class="mt-24 pt-8 border-t border-borderline/20 flex flex-col gap-6 md:flex-row md:justify-between md:items-center">
      <p class="font-body text-sm text-muted">
        &copy; {new Date().getFullYear()} {person.fullName}. All rights reserved.
      </p>
      <a href="#top" class="headline text-sm text-foreground transition-colors duration-300 hover:text-accent">
        Back to top &uarr;
      </a>
    </div>
  </div>
</footer>
